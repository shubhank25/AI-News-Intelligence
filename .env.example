# PostgreSQL
DB_HOST=localhost
# DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=ai_news_intelligence
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSLMODE=require

#news sources
NEWS_SOURCES=
https://feeds.bbci.co.uk/news/technology/rss.xml,
https://hnrss.org/frontpage,
https://blog.google/technology/ai/rss/

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Local Ollama (Docker backend reaches Windows host through host.docker.internal)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=120

ENABLE_GEMINI_SCHEDULER = True
ENABLE_OLLAMA_SCHEDULER = True

#news sources
NEWS_FEEDS='[
  {
    "name": "BBC Technology",
    "url": "https://feeds.bbci.co.uk/news/technology/rss.xml",
    "category": "Technology",
    "language": "en"
  },
  {
    "name": "Hacker News",
    "url": "https://hnrss.org/frontpage",
    "category": "Technology",
    "language": "en"
  },
  {
    "name": "Google AI Blog",
    "url": "https://blog.google/technology/google-labs/rss/",
    "category": "Artificial Intelligence",
    "language": "en"
  }
]'